#: data/io.github.sniper1720.khushu.desktop.in
#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in src/main.rs
#: src/pages.rs
msgid "Khushu"
msgstr "Khushu"

#: data/io.github.sniper1720.khushu.desktop.in
#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in src/main.rs
msgid "An all-in-one Muslim app for Linux"
msgstr "Una aplicación musulmana todo en uno para Linux"

#: data/io.github.sniper1720.khushu.desktop.in
msgid "Prayer;Islam;Salah;"
msgstr "Oración;Islam;Salah;Corán;Adhan;"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Khushu is your all-in-one Muslim app for Linux desktop, tablets, and "
"smartphones. It centralizes your daily worship by providing accurate prayer "
"times, native staggered Adkar notifications, and a dedicated Noble Quran "
"reader with ayah-by-ayah recitation."
msgstr ""
"Khushu es tu aplicación integral para musulmanes en Linux, disponible para "
"equipos de escritorio, tabletas y teléfonos inteligentes. Reúne todo lo "
"necesario para tu práctica diaria: horarios de oración precisos, "
"notificaciones nativas y escalonadas de adhkar y un lector dedicado del "
"Noble Corán con recitación versículo por versículo."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Morning, Evening, and Night Adkar with built-in counters"
msgstr "Adkar de la mañana, tarde y noche con contadores integrados"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Customizable Adhan system notifications (Makkah/Madinah audio)"
msgstr "Notificaciones de Adhan personalizables (audio de Makkah/Madinah)"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Dedicated Noble Quran reader with authentic Uthmanic text, multi-language "
"translations, ayah-by-ayah recitation, selectable reciters, and adjustable "
"typography"
msgstr ""
"Lector dedicado del Noble Corán con texto auténtico en escritura uthmánica, "
"traducciones en varios idiomas, recitación versículo por versículo, "
"selección de recitadores y tipografía personalizable."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Interactive Qibla compass"
msgstr "Brújula de Qibla interactiva"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Hijri calendar mapping"
msgstr "Calendario Hijri"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Privacy-first local encryption for your location data"
msgstr "Cifrado local de datos de ubicación con prioridad en la privacidad"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Modern Libadwaita interface with adaptive Dark Mode"
msgstr "Interfaz Libadwaita moderna con modo oscuro adaptativo"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Multi-language support"
msgstr "Soporte multilingüe"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Welcome & Onboarding: Easy first-time setup for location, language, and "
"calculation method"
msgstr ""
"Bienvenida y configuración: ajuste inicial fácil de ubicación, idioma y "
"método de cálculo"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Prayer Times Dashboard: View accurate daily Salah times, upcoming prayer "
"countdown, and Hijri date"
msgstr ""
"Panel de horarios de oración: consulta los horarios diarios precisos, la "
"cuenta regresiva de la próxima oración y la fecha Hijri"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Hijri Calendar: Browse the full Islamic calendar with accurate Hijri date "
"mapping"
msgstr ""
"Calendario Hijri: navega por el calendario islámico completo con la "
"conversión precisa de fechas"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Interactive Qibla compass pointing to Mecca via GPS or E-Compass sensor"
msgstr ""
"Brújula de Qibla interactiva que señala hacia La Meca mediante GPS o sensor "
"electrónico"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Noble Quran: Read Arabic ayat and translations with adjustable typography "
"and listen to recitations with selectable reciters"
msgstr ""
"Noble Corán: Lee los versículos en árabe junto con sus traducciones, ajusta "
"la tipografía y escucha la recitación con el recitador que prefieras."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Adkar & Supplications: Access Daily Adkar with built-in counters and "
"staggered notifications"
msgstr ""
"Adkar y súplicas: accede a los Adkar diarios con contadores integrados y "
"notificaciones escalonadas"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"App Settings: Configure your location, language, appearance, and prayer "
"settings"
msgstr ""
"Configuración de la aplicación: configura tu ubicación, idioma, apariencia y "
"ajustes de oración"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Djalel Oukid"
msgstr "Djalel Oukid"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "prayer"
msgstr "oración"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "salah"
msgstr "salah"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "adhan"
msgstr "adhan"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "adkar"
msgstr "adkar"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "quran"
msgstr "corán"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "recitation"
msgstr "recitación"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "qibla"
msgstr "qibla"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "muslim"
msgstr "musulmán"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "islam"
msgstr "islam"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added a searchable timezone selection dialog with local time preview and UTC "
"offset details"
msgstr ""
"Se añadió un cuadro de diálogo para seleccionar la zona horaria con "
"búsqueda, vista previa de la hora local y detalles del desfase respecto a "
"UTC."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Added user-selectable high-latitude rules and polar estimation methods"
msgstr ""
"Se añadieron reglas para latitudes altas seleccionables por el usuario y el "
"Método de Estimación Polar."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added status notifications for high-latitude and polar estimation methods"
msgstr ""
"Se añadieron notificaciones de estado para los métodos de latitudes altas y "
"el Método de Estimación Polar."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed missed prayer notifications after system sleep or system clock "
"adjustments"
msgstr ""
"Se corrigieron las notificaciones de oración omitidas tras reanudar el "
"sistema desde suspensión o después de ajustar el reloj del sistema."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed Iqamah and morning Adkar notification timing to prevent overlap with "
"Adhan playback"
msgstr ""
"Se corrigió el horario de las notificaciones del iqamah y los adhkar de la "
"mañana para evitar que se superpongan con la reproducción del adhan."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Modernized the reciter selection dialog layout"
msgstr ""
"Se modernizó el diseño del cuadro de diálogo de selección del recitador."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added high-latitude prayer time estimation (LocalRelativeEstimation for "
"48.6°–66.5° and NearestLatitude polar fallback for >66.5°)"
msgstr ""
"Se añadió la estimación de los horarios de oración para latitudes altas "
"(LocalRelativeEstimation para latitudes entre 48.6° y 66.5°, y "
"NearestLatitude como método de respaldo para las regiones polares por encima "
"de 66.5°)."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Migrated prayer time library from salah to mawaqit for high-latitude and "
"polar zone support"
msgstr ""
"Se migró la biblioteca de horarios de oración de `salah` a `mawaqit` para "
"ofrecer compatibilidad con latitudes altas y regiones polares."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed blank label in KDE tray settings"
msgstr ""
"Se corrigió una etiqueta vacía en la configuración del icono de la bandeja "
"del sistema en KDE."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed verse highlighting, navigation, and recitation on multi-Surah pages"
msgstr ""
"Se corrigieron el resaltado de versículos, la navegación y la recitación en "
"las páginas que contienen varias suras."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Surah header now updates when clicking a verse from a different Surah on "
"multi-Surah pages"
msgstr ""
"El encabezado de la sura ahora se actualiza automáticamente al hacer clic en "
"un versículo de otra sura en las páginas que contienen varias suras."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Translated Surah name labels now truncate with ellipsis to prevent overflow "
"on narrow windows"
msgstr ""
"Las etiquetas con los nombres traducidos de las suras ahora se truncan con "
"puntos suspensivos (…) para evitar que el texto se desborde en ventanas "
"estrechas."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Reduced memory usage by sharing Quran data between callers instead of "
"cloning it"
msgstr ""
"Se redujo el uso de memoria al compartir los datos del Corán entre los "
"llamadores en lugar de duplicarlos."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed tray icon always showing dark on GNOME/XFCE in Flatpak"
msgstr ""
"Se corrigió el problema por el que el icono de la bandeja del sistema "
"siempre aparecía oscuro en GNOME y XFCE con Flatpak."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed lock-poison panics in tray FFI/D-Bus code"
msgstr ""
"Se corrigieron los panic provocados por lock poisoning en el código FFI y D-"
"Bus del icono de la bandeja del sistema."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Removed tray icon file-copy workaround and its associated Flatpak filesystem "
"permission"
msgstr ""
"Se eliminó la solución temporal para copiar los archivos del icono de la "
"bandeja del sistema, junto con el permiso de acceso al sistema de archivos "
"de Flatpak asociado."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added Noble Quran Recitation with ayah-by-ayah audio playback and reciter "
"selection."
msgstr ""
"Se añadieron las recitaciones del Noble Corán con reproducción de audio "
"versículo por versículo y selección de recitador."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Rewrote locale switching for consistent i18n across all modules."
msgstr ""
"Se reescribió el sistema de cambio de idioma para garantizar una "
"internacionalización (i18n) coherente en toda la aplicación."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed tray icon invisible on KDE dark panel."
msgstr ""
"Se corrigió el problema del icono de la bandeja del sistema invisible en el "
"panel oscuro de KDE."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed Arabic mushaf search scroll navigation."
msgstr ""
"Se corrigió la navegación mediante desplazamiento durante la búsqueda en el "
"mushaf árabe."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed pagination boundary alignment for accurate mushaf-style navigation."
msgstr ""
"Se corrigió la alineación de los límites de paginación para una navegación "
"precisa al estilo mushaf."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Added Indonesian (id) translation by WiqbalRar."
msgstr "Se añadió la traducción al indonesio (id) por WiqbalRar."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed custom audio save crash on non-main thread."
msgstr ""
"Se corrigió un fallo al guardar audios personalizados fuera del hilo "
"principal."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed language not persisting after app restart."
msgstr ""
"Se corrigió el problema que impedía conservar el idioma después de reiniciar "
"la aplicación."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed data loss on exit with synchronous atomic config save."
msgstr ""
"Se corrigió la pérdida de datos al salir mediante un guardado atómico y "
"síncrono de la configuración."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed autostart portal command double-wrapping."
msgstr ""
"Se corrigió el doble encapsulado del comando del portal de inicio automático."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed notification toggles reverting on restart due to UI override."
msgstr ""
"Se corrigió el restablecimiento de las opciones de notificación al reiniciar "
"debido a una sobrescritura de la interfaz."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed audio selection reverting on restart due to file check on bundled "
"presets."
msgstr ""
"Se corrigió el restablecimiento de la selección de audio al reiniciar debido "
"a una comprobación de archivos en los sonidos integrados."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Improved audio playback engine with streaming decode."
msgstr ""
"Motor de reproducción de audio mejorado con decodificación en streaming."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Improved Qibla compass performance with Pango and bearing caching."
msgstr ""
"Rendimiento de la brújula Qibla mejorado con caché de Pango y orientación."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Improved timer controller with daily state caching."
msgstr "Controlador de temporizador mejorado con caché de estado diario."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Improved config persistence with singleton save channel."
msgstr "Persistencia de configuración mejorada con canal de guardado único."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed application crashes caused by notification re-entrancy."
msgstr ""
"Corregidos cierres inesperados causados por reentrada de notificaciones."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed configuration data race when saving from multiple threads."
msgstr "Corregida condición de carrera al guardar desde múltiples hilos."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed thread safety issues in locale setup and audio initialization."
msgstr ""
"Corregidos problemas de seguridad en hilos durante la configuración de "
"idioma e inicio de audio."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Replaced 26 unsafe unwrap() calls with proper error messages."
msgstr ""
"Reemplazadas 26 llamadas inseguras unwrap() con mensajes de error "
"descriptivos."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Added Adhan Only Mode toggle to keep only Adhan alerts."
msgstr ""
"Se añadió el modo Solo Adhan para mantener únicamente las notificaciones de "
"Adhan"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Added Iqamah Alert toggle to separately control Iqamah notifications."
msgstr ""
"Se añadió la opción Alerta de Iqamah para controlar por separado las "
"notificaciones de Iqamah"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added new prayer calculation methods for France (UOIF), Algeria (Ministry of "
"Religious Affairs and Wakfs), and KEMENAG (Indonesia)."
msgstr ""
"Se añadieron nuevos métodos de cálculo para Francia (UOIF), Argelia "
"(Ministerio de Asuntos Religiosos y Wakfs) y KEMENAG (Indonesia)"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed Flatpak tray icon visibility with XDG portal icon path support."
msgstr ""
"Se corrigió la visibilidad del icono de Flatpak mediante soporte para rutas "
"de iconos del portal XDG"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Improved tray activation: clicking \"Open Khushu\" from system tray now "
"directly shows the app window."
msgstr ""
"Se mejoró la activación desde la bandeja del sistema: al hacer clic en «Open "
"Khushu», la ventana de la aplicación se muestra directamente en primer plano"

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added a fully offline Noble Qur'an module featuring the Qur'anic text in "
"Uthmanic orthography (rasm), translations, mushaf-style navigation, "
"diacritic-aware search, saved reading positions, and adjustable typography."
msgstr ""
"Se añadió un módulo completo del Noble Corán sin conexión, que incluye el "
"texto coránico en ortografía uthmánica (rasm), traducciones, navegación tipo "
"mushaf, búsqueda sensible a los diacríticos, guardado de la posición de "
"lectura y tipografía ajustable."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Added Mawaqit API integration as an alternative prayer times source."
msgstr ""
"Se añadió la integración de Mawaqit API como fuente alternativa de horarios "
"de oración."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added ICU-backed localization for location and timezone labels, plus "
"validated custom IANA timezone editing."
msgstr ""
"Se añadió soporte de ICU para la localización de etiquetas de ubicación y "
"zona horaria, junto con la validación de la edición personalizada de zonas "
"horarias IANA."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Reorganized settings into clearer General, Prayer Setup, and Alerts sections "
"with improved inline editing behavior."
msgstr ""
"Se reorganizaron los ajustes en secciones más claras: General, Configuración "
"de oración y Alertas, con mejoras en la edición en línea."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed Snap tray icon visibility via an upstream patch to ksni (resolves "
"AppArmor D-Bus blocking)."
msgstr ""
"Se corrigió la visibilidad del icono de la bandeja de Snap mediante un "
"parche upstream en ksni (resuelve el bloqueo de D-Bus por AppArmor)."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed Snap autostart and notification icon rendering."
msgstr ""
"Corrección del inicio automático de Snap y la visualización del icono de "
"notificaciones."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Improved locale detection and fallback logic."
msgstr "Mejora en la detección de idioma y lógica de respaldo."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed Flatpak autostart failure and missing --background flag."
msgstr ""
"Corrección del fallo del inicio automático de Flatpak y la bandera --"
"background faltante."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Fixed over-translation of proper nouns (e.g., Muslim) in non-English locales."
msgstr ""
"Corrección de la traducción excesiva de nombres propios (ej.: Muslim) en "
"idiomas no ingleses."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Added new localized AppStream screenshots for improved store presence."
msgstr ""
"Capturas de pantalla localizadas para una mejor presencia en la tienda."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed tray icon translation extraction (Quit and Open Khushu entries)."
msgstr ""
"Corrección de la extracción de traducciones del icono de bandeja (entradas "
"Salir y Abrir Khushu)."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed AppStream metadata translation (descriptions and keywords)."
msgstr ""
"Corrección de la traducción de metadatos de AppStream (descripciones y "
"palabras clave)."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Improved tray behavior to update labels immediately on language change."
msgstr ""
"Mejora del comportamiento de bandeja para actualizar etiquetas "
"inmediatamente al cambiar de idioma."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Initial stable release of Khushu."
msgstr "Primera versión estable de Khushu."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Accurate offline prayer (Salah) calculation methods, including recommended "
"high-latitude and polar estimation methods."
msgstr ""
"Métodos precisos de cálculo de los horarios de oración (Salah) sin conexión, "
"que incluyen los métodos de estimación recomendados para altas latitudes y "
"regiones polares."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Added native Adkar translations in French, Spanish, Turkish, and Indonesian, "
"verified against authentic sources"
msgstr ""
"Se añadieron traducciones auténticas de los Adhkar en francés, español, "
"turco e indonesio, verificadas con fuentes confiables."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid ""
"Daily Adkar reminders now prioritize favorited Adkar over random selection"
msgstr ""
"Los recordatorios diarios de Adhkar ahora priorizan los Adhkar favoritos "
"sobre la selección aleatoria."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed the Indonesian UI selection not persisting after restart"
msgstr ""
"Se corrigió el problema por el cual la selección del idioma indonesio en la "
"interfaz no se guardaba tras reiniciar."

#: data/appdata/io.github.sniper1720.khushu.metainfo.xml.in
msgid "Fixed the invalid adhan file toast never showing"
msgstr ""
"Se corrigió el problema por el cual la notificación (toast) de archivo de "
"adhan no válido nunca se mostraba."

